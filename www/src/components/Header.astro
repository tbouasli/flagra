---
import Logo from "@/assets/logo.svg";
---

<header class="flex justify-center bg-background px-4 py-4 h-14 sm:px-8 sm:h-20">
    <div class="flex flex-row justify-between items-center gap-4 container">
        <a href="/">
            <div class="flex flex-row items-center gap-4">
                <Logo class="w-10 h-10 sm:w-16 sm:h-16" />
                <h1 class="text-2xl font-sans font-bold uppercase">Flagra</h1>
            </div>
        </a>
        <nav class="flex-row gap-8 items-center hidden md:flex">
            <a href="/sobre-nos">Sobre Nós</a>
            <a
                href="/"
                class="bg-primary text-primary-foreground px-4 py-2 rounded-md"
                >Entre em Contato</a
            >
        </nav>
    </div>
</header>
