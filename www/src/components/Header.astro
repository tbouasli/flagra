---
import Logo from "@/assets/logo.svg";
import MobileMenu from "./MobileMenu.astro";
---

<header class="flex justify-center bg-background px-8 py-4 h-20">
    <div class="flex flex-row justify-between items-center gap-4 container">
        <div class="flex flex-row items-center gap-4">
            <Logo />
            <h1 class="text-2xl font-sans font-bold uppercase">Flagra</h1>
        </div>
        <nav class="flex-row gap-8 items-center hidden md:flex">
            <a href="/">Sobre Nós</a>
            <a
                href="/"
                class="bg-primary text-primary-foreground px-4 py-2 rounded-full"
                >Entre em Contato</a
            >
        </nav>
        <MobileMenu client:load />
    </div>
</header>
