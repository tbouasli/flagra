---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client"

import type { Collection } from "@/types"


import Layout from "@/layouts/Layout.astro";

import HeroImage from "@/assets/hero.jpg";
import HeroDecor from "@/assets/hero-decor.svg";
import Section from "@/layouts/Section.astro";
import Carousel from "./_components/Carousel";

const collections: Collection[] = await sanityClient.fetch(`*[_type == "collection"]`)

---

<Layout title="Flagra">
	<!-- Hero -->
	<section id="hero" class="relative h-[calc(100vh-10rem)]">
		<Image src={HeroImage} alt="Hero Image" class="absolute inset-0 w-full h-full object-cover object-top" />
		<div class="absolute inset-0 bg-primary/20"/>
		<div class="absolute left-1/6 top-1/2 -translate-y-1/2 flex justify-center">
			<div class="relative flex z-20 flex-col font-bold text-primary-foreground font-sans">
				<span class="font-normal text-xl">
					Conheça nossa
				</span>
				<h1 class="text-5xl sm:text-6xl">
					Coleção
					</br>
					Básicos
				</h1>
				<span class="text-3xl sm:text-4xl">
					2026
				</span>
			</div>
			<div id="hero-decor" class="absolute z-10 top-0 right-2/5 w-full h-[120%] sm:h-[150%] object-cover overflow-hidden">
				<Image src={HeroDecor} alt="Hero Decor" class="absolute top-0 left-0 w-full h-full object-cover" />
			</div>
		</div>
	</section>

	<!-- Collections -->
	<Section id="collections">
		<header class="mb-4">
			<h2 class="text-2xl font-bold text-primary font-sans sm:text-4xl mb-4 sm:mb-8">Confira nossas coleções</h2>
		</header>
		<Carousel collections={collections} />
	</Section>

	<!-- Contact -->
	<Section id="contact">
		<header class="mb-16 space-y-8">
			<h2 class="text-2xl font-bold text-primary font-sans sm:text-4xl mb-4 sm:mb-8">Contato</h2>
			<p class="text-primary text-md font-normal sm:text-lg">A Flagra é uma confecção de roupas e não trabalha com varejo diretamente, por isso, caso deseje produzir ou vender nossos produtos, entre em contato conosco.</p>
		</header>
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<!-- Quero Produzir Card -->
			<div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2">
				<div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-50 to-transparent rounded-bl-full opacity-50"></div>
				
				<div class="relative">
					<div class="mb-6 inline-flex items-center justify-center w-14 h-14 rounded-full bg-blue-100 text-blue-600 transition-colors group-hover:bg-blue-600 group-hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
							<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
						</svg>
					</div>
					
					<h3 class="text-2xl font-bold text-gray-900 mb-3">Quero produzir</h3>
					
					<p class="text-gray-600 mb-6 leading-relaxed">
						Entre em contato conosco para produzir seus produtos com qualidade e expertise da Flagra.
					</p>
					
					<div class="space-y-3">
						<a href="mailto:contato@flagra.com.br" class="flex items-center gap-3 text-blue-600 hover:text-blue-700 transition-colors font-medium group/link">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
							</svg>
							<span class="group-hover/link:underline">contato@flagra.com.br</span>
						</a>
					</div>
				</div>
			</div>
	
			<!-- Quero Vender Card -->
			<div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2">
				<div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-green-50 to-transparent rounded-bl-full opacity-50"></div>
				
				<div class="relative">
					<div class="mb-6 inline-flex items-center justify-center w-14 h-14 rounded-full bg-green-100 text-green-600 transition-colors group-hover:bg-green-600 group-hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 3.348 3h17.304a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
						</svg>
					</div>
					
					<h3 class="text-2xl font-bold text-gray-900 mb-3">Quero vender</h3>
					
					<p class="text-gray-600 mb-6 leading-relaxed">
						Seja um revendedor e faça parte da rede de distribuição dos produtos Flagra.
					</p>
					
					<div class="space-y-3">
						<a href="mailto:vendas@flagra.com.br" class="flex items-center gap-3 text-green-600 hover:text-green-700 transition-colors font-medium group/link">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
							</svg>
							<span class="group-hover/link:underline">vendas@flagra.com.br</span>
						</a>
					</div>
				</div>
			</div>
	
			<!-- Quero Comprar Card -->
			<!-- <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2">
				<div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-purple-50 to-transparent rounded-bl-full opacity-50"></div>
				
				<div class="relative">
					<div class="mb-6 inline-flex items-center justify-center w-14 h-14 rounded-full bg-purple-100 text-purple-600 transition-colors group-hover:bg-purple-600 group-hover:text-white">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
						</svg>
					</div>
					
					<h3 class="text-2xl font-bold text-gray-900 mb-3">Quero comprar</h3>
					
					<p class="text-gray-600 mb-6 leading-relaxed">
						Encontre os produtos Flagra através dos nossos revendedores autorizados.
					</p>
					
					<div class="space-y-3">
						<a href="mailto:comercial@flagra.com.br" class="flex items-center gap-3 text-purple-600 hover:text-purple-700 transition-colors font-medium group/link">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
							</svg>
							<span class="group-hover/link:underline">comercial@flagra.com.br</span>
						</a>
					</div>
				</div>
			</div> -->
		</div>
	</Section>
</Layout>
