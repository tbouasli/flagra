---
import HeroImage from "@/assets/hero.jpg";
import HeroDecor from "@/assets/hero-decor.svg";
import { Image } from "astro:assets";
import imageUrlBuilder from '@sanity/image-url'


import { sanityClient } from "sanity:client";

// 
// only fetch the first page
const landingPage = await sanityClient.fetch(`*[_type == "page" && slug.current == "landing-page"]`);

console.log(landingPage[0].content[0]);

const builder = imageUrlBuilder(sanityClient);

const imageUrl = builder.image(landingPage[0].content[0].image).url();

const smallText = landingPage[0].content[0].text.find((text: any) => text.size === "small");
const mediumText = landingPage[0].content[0].text.find((text: any) => text.size === "medium");
const largeText = landingPage[0].content[0].text.find((text: any) => text.size === "large");

---

<section id="hero" class="relative h-[calc(100vh-10rem)]">
    <img src={imageUrl} alt="Hero Image" class="absolute inset-0 w-full h-full object-cover object-top" />
    <div class="absolute inset-0 bg-primary/20"/>
    <div class="absolute left-1/6 top-1/2 -translate-y-1/2 flex justify-center">
        <div class="relative flex z-20 flex-col font-bold text-primary-foreground font-sans">
            <span class="text-xl font-normal">
                {smallText?.text}
            </span>
            <h1 class="text-6xl">
                {largeText?.text}
            </h1>
            <span class="text-4xl">
                {mediumText?.text}
            </span>
        </div>
        <div id="hero-decor" class="absolute z-10 top-0 right-2/5 w-full h-[150%] object-cover overflow-hidden">
            <Image src={HeroDecor} alt="Hero Decor" class="absolute top-0 left-0 w-full h-full object-cover" />
        </div>
    </div>
</section>